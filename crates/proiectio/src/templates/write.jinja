{#- A dry run carries the plan's rows, a real run the applied report's. -#}
{%- set planning = rows is defined -%}
{%- set entries = (rows if planning else report.rows)|items -%}
{%- set column = namespace(path=0) -%}
{%- for entry in entries -%}
{%- set shown = (entry[0]|verbatim)|length -%}
{%- if shown > column.path %}{% set column.path = shown %}{% endif -%}
{%- endfor -%}
{%- set tally = namespace(wrote=0, skipped=0, removed=0, released=0) -%}
{%- for path, row in entries -%}
{%- set shape = row.facts.shape if row.facts else none -%}
{%- set target = shape.Symlink.target if shape and shape.Symlink is defined else none -%}
{%- set verdict = row.verdict -%}
{%- set note = "" -%}
{%- if verdict == "Write" -%}
{%- set style = "wrote" -%}
{%- set verb = "would link" if target else "would write" -%}
{%- elif verdict == "Written" -%}
{%- set style = "wrote" -%}
{%- set verb = "linked" if target else "wrote" -%}
{%- set tally.wrote = tally.wrote + 1 -%}
{%- elif verdict.Overwrite is defined -%}
{%- set style = "overwrote" -%}
{%- set verb = "would overwrite" -%}
{%- set reason = verdict.Overwrite.reason -%}
{%- if reason == "ContentChanged" -%}
{%- set note = "(content changed)" -%}
{%- elif reason == "ExecutableChanged" -%}
{%- set note = "(executable changed)" -%}
{%- else -%}
{%- set note = "(drifted, forced)" -%}
{%- endif -%}
{%- elif verdict == "Overwritten" -%}
{%- set style = "overwrote" -%}
{%- set verb = "overwrote" -%}
{%- set tally.wrote = tally.wrote + 1 -%}
{%- elif verdict == "Skip" -%}
{%- set style = "skipped" -%}
{%- set verb = "would skip" -%}
{%- elif verdict == "Skipped" -%}
{%- set style = "skipped" -%}
{%- set verb = "skipped" -%}
{%- set tally.skipped = tally.skipped + 1 -%}
{%- elif verdict == "Remove" -%}
{%- set style = "removed" -%}
{%- set verb = "would remove" -%}
{%- elif verdict == "Removed" -%}
{%- set style = "removed" -%}
{%- set verb = "removed" -%}
{%- set tally.removed = tally.removed + 1 -%}
{%- elif verdict == "Release" -%}
{%- set style = "removed" -%}
{%- set verb = "would release" -%}
{%- elif verdict == "Released" -%}
{%- set style = "removed" -%}
{%- set verb = "released" -%}
{%- set tally.released = tally.released + 1 -%}
{%- else -%}
{%- set style = "unknown" -%}
{%- set verb = (verdict|string)|verbatim -%}
{%- endif -%}
{%- if target -%}
{%- set style = "linked" -%}
{%- set note = ("-> " ~ (target|verbatim) ~ "  " ~ note)|trim -%}
{%- elif shape and shape.File is defined and shape.File.executable and not note -%}
{%- set note = "(exec)" -%}
{%- endif -%}
{%- set verb = "[" ~ style ~ "]" ~ verb ~ "[/" ~ style ~ "]" -%}
{{ verb|pad_right(15 if planning else 9) }}  {% if note %}{{ (path|verbatim)|pad_right(column.path) }}  {{ note }}{% else %}{{ path|verbatim }}{% endif %}
{% endfor -%}
{%- if not planning -%}
{%- if tally.wrote == 0 and tally.removed == 0 and tally.released == 0 and tally.skipped > 0 -%}
{%- set summary = tally.skipped ~ " unchanged" -%}
{%- else -%}
{%- set summary = tally.wrote ~ " written, " ~ tally.skipped ~ " skipped" -%}
{%- if tally.removed -%}
{%- set summary = summary ~ ", " ~ tally.removed ~ " removed" -%}
{%- endif -%}
{%- if tally.released -%}
{%- set summary = summary ~ ", " ~ tally.released ~ " released" -%}
{%- endif -%}
{%- endif -%}
{{ summary }}
{% endif -%}
