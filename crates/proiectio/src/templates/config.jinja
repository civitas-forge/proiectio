{#- One template for the whole config group: branches on the ConfigView tag.
    Every assignment line is the view's own, spelled as a line of the file. -#}
{% if kind == "listing" -%}
{{ rendered }}
{% elif kind == "key_value" -%}
{{ rendered }}
{% elif kind == "value_set" -%}
[ok]set[/ok] {{ rendered }}
[ok]wrote[/ok] {{ path }}
{% elif kind == "value_unset" -%}
[ok]unset[/ok] [key]{{ key }}[/key]
{% if wrote -%}
[ok]wrote[/ok] {{ path }}
{% else -%}
[skipped]no file at[/skipped] {{ path }}
{% endif -%}
{% elif kind == "template" -%}
{{ body }}
{% elif kind == "template_written" -%}
[ok]wrote[/ok] {{ path }}
{% elif kind == "schema" -%}
{{ body }}
{% elif kind == "schema_written" -%}
[ok]wrote[/ok] {{ path }}
{% endif -%}
